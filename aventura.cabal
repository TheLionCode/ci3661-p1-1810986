cabal-version:      2.4
name:               aventura
version:            0.1.0.0
synopsis:           Motor de aventuras de texto
license:            AllRightsReserved
build-type:         Simple

library
  exposed-modules:  Motor.Tipos
                  , Motor.Reconocedor
                  , Motor.Mundo
                  , Motor.Comandos
                  , Motor.Nucleo
                  , Motor.Persistencia
  hs-source-dirs:   src
  build-depends:    base >=4.15 && <5
                  , containers
                  , directory
                  , filepath
  default-language: Haskell2010
  ghc-options:      -Wall

executable aventura
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:    base >=4.15 && <5
                  , containers
                  , aventura
  default-language: Haskell2010
  ghc-options:      -Wall

test-suite pruebas
  type:             exitcode-stdio-1.0
  main-is:          Pruebas.hs
  hs-source-dirs:   test
  build-depends:    base >=4.15 && <5
                  , containers
                  , directory
                  , filepath
                  , HUnit
                  , aventura
  default-language: Haskell2010
  ghc-options:      -Wall
